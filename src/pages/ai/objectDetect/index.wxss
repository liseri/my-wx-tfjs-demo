/* index.wxss */
.container {
  padding: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin: 20rpx 0;
}

.section {
  margin: 30rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 10rpx 0;
}

.camera-container {
  margin: 20rpx 0;
}

.camera {
  width: 100%;
  height: 500rpx;
  background-color: #000;
}

.detection-container {
  position: relative;
  margin: 20rpx 0;
}

.detection-image {
  width: 100%;
  height: auto;
}

.detection-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  pointer-events: none;
}

.highlighter {
  position: absolute;
  border: 2rpx solid red;
  background-color: rgba(255, 0, 0, 0.1);
  z-index: 10;
}

.info {
  position: absolute;
  background-color: rgba(255, 0, 0, 0.8);
  color: white;
  padding: 5rpx 10rpx;
  font-size: 24rpx;
  z-index: 20;
}

/* 统计信息样式 */
.stats-section {
  margin-top: 30rpx;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
}

.stats-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.stats-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.stats-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx;
  background-color: white;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.stats-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.stats-info {
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
}

.stats-count {
  color: #666;
}

.stats-score {
  color: #07c160;
  font-weight: bold;
}